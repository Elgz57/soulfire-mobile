{
  "name": "soulfire-mobile",
  "version": "2.9.15",
  "description": "Mobile client for SoulFire.",
  "type": "module",
  "private": true,
  "scripts": {
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fix": "biome check --write --unsafe",
    "check": "biome check",
    "generate-assets": "node scripts/generate-asset-sources.mjs && capacitor-assets generate",
    "sync": "pnpm build && cap sync",
    "android": "pnpm sync && cap open android",
    "android:apk": "pnpm sync && cd android && ./gradlew assembleDebug",
    "android:bundle": "pnpm sync && cd android && ./gradlew bundleRelease",
    "ios": "pnpm sync && cap open ios"
  },
